[user]
	name = Your Name
	email = your.email@example.com

[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	autocrlf = input
	filemode = false

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = simple
	followTags = true

[fetch]
	prune = true

[diff]
	tool = vimdiff
	colorMoved = zebra

[merge]
	tool = vimdiff
	conflictstyle = diff3

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[alias]
	# Short commands
	st = status
	co = checkout
	br = branch
	ci = commit
	
	# Useful shortcuts
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = log --graph --oneline --all
	
	# Pretty logs
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	
	# Amend last commit
	amend = commit --amend --no-edit
	
	# Show files in last commit
	last-files = diff-tree --no-commit-id --name-only -r HEAD
	
	# Undo last commit but keep changes
	undo = reset --soft HEAD^
	
	# Discard all local changes
	discard = checkout -- .
	
	# List all aliases
	aliases = config --get-regexp alias

[help]
	autocorrect = 1
